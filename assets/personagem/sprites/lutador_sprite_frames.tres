[gd_resource type="SpriteFrames" load_steps=11 format=3]

; AS NOVE POSES SAO RECORTES DE UMA FOLHA UNICA, E ELAS SE TOCAM.
;
; Medindo o alfa da folha, sete das nove poses encostam em pelo menos
; uma borda da propria celula: `nocaute` chega na coluna 409 (a ultima)
; e `recuperacao`, a vizinha da direita, comeca na coluna 0. Com filtro
; linear, a amostragem da borda pega meio texel do LADO DE FORA da
; regiao -- ou seja, da pose vizinha -- e o resultado e um fiapo do
; desenho ao lado grudado no contorno.
;
; `filter_clip` prende a amostragem dentro da regiao. Custa nada, nao
; muda um pixel do interior e e o que mantem a sequencia limpa
; enquanto as poses continuarem coladas umas nas outras.

[ext_resource type="Texture2D" path="res://assets/personagem/sprites/lutador_folha_3x3.png" id="1_folha"]

[sub_resource type="AtlasTexture" id="Atlas_guarda"]
atlas = ExtResource("1_folha")
region = Rect2(0, 0, 410, 426)
filter_clip = true

